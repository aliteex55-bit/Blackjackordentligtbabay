#!/bin/sh
# Flodesschema for Mac: opens the interactive flowchart of the game Tjugoett.
#
# Asked for: a Mac version that is equivalent to Flodesschema.exe.
# The Windows exe carries the flowchart page inside it, writes the page to a
# temporary folder and opens it in a browser window. This launcher does the
# same on a Mac: the page lies in the folder beside it, Contents/Resources.
# It only uses programs that are part of macOS (sh, dirname, mktemp, cat, open).
# Built on Windows and not yet run on a Mac. The game does not use this file.
#
# The app is not signed. If macOS blocks it after a download, allow it under
# System Settings > Privacy & Security > Open Anyway.
#
# Generated by a local build script (extra/bygg-flodesschema.pl, not in the
# repository). Do not edit by hand.

# Find the page from the place of this file, so the app works wherever it is put.
resources="$(cd "$(dirname "$0")/../Resources" && pwd)"
page="$resources/flodesschema-interaktiv.html"

# Stop if the page is missing. The message is only seen when the launcher is
# started from Terminal.
if [ ! -f "$page" ]; then
    echo "Flodesschema: the page is missing: $page" >&2
    exit 1
fi

# Copy the page to a temporary folder first, as the exe does (here a new folder
# for every start). macOS can run a downloaded app from a temporary place that
# disappears when the app ends, and the browser needs a file that is still there
# afterwards.
folder="$(mktemp -d "${TMPDIR:-/tmp}/flodesschema.XXXXXX")" || exit 1
cat "$page" > "$folder/flodesschema.html" || exit 1

# "open" is the macOS command that opens a file with the program set for it.
# For an .html file that is normally the browser.
open "$folder/flodesschema.html"
