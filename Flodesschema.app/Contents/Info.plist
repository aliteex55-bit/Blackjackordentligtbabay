<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Flodesschema.app: the Mac version of the interactive flowchart of Tjugoett.
     Asked for: a Mac version that is equivalent to Flodesschema.exe.
     This file tells macOS that the folder is a program and which file inside it to start.
     Generated by a local build script (extra/bygg-flodesschema.pl, not in the repository).
     Do not edit by hand. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Flodesschema</string>
    <key>CFBundleDisplayName</key>
    <string>Flodesschema</string>
    <key>CFBundleIdentifier</key>
    <string>local.tjugoett.flodesschema</string>
    <key>CFBundleExecutable</key>
    <string>Flodesschema</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- The launcher is a script, not a compiled program. A Mac with an Apple processor
         treats such an app as made for Intel and may ask to install Rosetta. This list is
         the remedy in the Apple documentation: prefer the Apple processor, then Intel.
         Not yet tested on a Mac. -->
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>
</dict>
</plist>
